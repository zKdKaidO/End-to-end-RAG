# API Settings
PROJECT_NAME="End-to-End RAG (Block 1)"
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
REQUEST_MAX_JSON_BYTES=1048576
REQUEST_MAX_QUERY_CHARS=10000
PDF_MAX_FILENAME_LENGTH=255
PDF_MAX_PAGES=1000
PDF_MAX_EXTRACTED_CHARS=20000000
PDF_MAX_PAGE_EXTRACTED_CHARS=2000000
APP_ENV=development
DEBUG_UI_ENABLED=false
DEBUG_UI_ORIGINS=http://localhost:5173

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=rag_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=False
RETRIEVAL_TOP_K_DENSE_DEFAULT=50
RETRIEVAL_TOP_K_LEXICAL_DEFAULT=50
RETRIEVAL_TOP_K_FINAL_DEFAULT=10
RETRIEVAL_RRF_K_DEFAULT=60
RETRIEVAL_MAX_TOP_K_DENSE=200
RETRIEVAL_MAX_TOP_K_LEXICAL=200
RETRIEVAL_MAX_TOP_K_FINAL=100
RETRIEVAL_MAX_RRF_K=10000
RETRIEVAL_MAX_DOCUMENT_IDS=100

# Block 6 local generation (server-owned; not client-selectable)
GENERATION_PROVIDER=ollama
GENERATION_MODEL_ID=qwen3.5:9b
GENERATION_TOKENIZER_PROVIDER=huggingface
GENERATION_TOKENIZER_ID=Qwen/Qwen3.5-9B
GENERATION_MODEL_CONTEXT_LIMIT=32768
GENERATION_CONTEXT_BUDGET_TOKENS=4096
GENERATION_MAX_OUTPUT_TOKENS=512
GENERATION_PROMPT_TOKEN_SAFETY_MARGIN=32
GENERATION_THINKING=false
GENERATION_TEMPERATURE=0.0
GENERATION_TOP_P=0.9
GENERATION_TOP_K=20
GENERATION_PROMPT_VERSION=legal-rag-v2
GENERATION_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Distributed authentication and generation security controls.
AUTH_LOGIN_RATE_PER_MINUTE=10
AUTH_LOGIN_BURST=5
AUTH_LOGIN_NETWORK_RATE_PER_MINUTE=30
AUTH_LOGIN_NETWORK_BURST=10

# Deployment + Backup + Recovery V1. Local development keeps the first line.
DEPLOYMENT_PROFILE=development
RELEASE_ID=development
EXPECTED_MODEL_DIGEST=
TRUSTED_PROXY_CIDRS=
RECOVERY_CONTROL_DIR=tmp/recovery-control
BACKUP_DESTINATION=tmp/backups
BACKUP_DESTINATION_ENCRYPTED=false
BACKUP_DESTINATION_SEPARATE_FAILURE_DOMAIN=false
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_LAST=7
BACKUP_SCHEDULE=manual
RECOVERY_JOB_STALE_SECONDS=900
RESTORE_MAINTENANCE_WORK_MEM=256MB
RESTORE_MAX_PARALLEL_MAINTENANCE_WORKERS=1
RQ_RESULT_TTL_SECONDS=86400
RQ_FAILURE_TTL_SECONDS=604800
APPLICATION_LOG_RETENTION_DAYS=30
SECURITY_LOG_RETENTION_DAYS=90
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
CHAT_GENERATION_RATE_PER_MINUTE=5
CHAT_GENERATION_BURST=2
CHAT_MAX_ACTIVE_GENERATIONS_PER_USER=1
CHAT_MAX_GLOBAL_GENERATIONS=1
CHAT_GENERATION_LEASE_TTL_SECONDS=240
INGESTION_JOB_TIMEOUT_SECONDS=1800
PROCESSING_JOB_TIMEOUT_SECONDS=3600
INDEXING_JOB_TIMEOUT_SECONDS=3600
SECURITY_HSTS_ENABLED=false
