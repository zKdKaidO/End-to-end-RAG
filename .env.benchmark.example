# Copy to .env.benchmark for the local isolated capacity benchmark only.
# Never point these variables at normal-development services.
DEPLOYMENT_PROFILE=benchmark
BENCHMARK_RUNTIME_MARKER=rag-benchmark-v1
DB_USER=benchmark
DB_PASSWORD=replace-with-local-benchmark-password
DB_NAME=rag_benchmark
DATABASE_URL=postgresql://benchmark:replace-with-local-benchmark-password@benchmark-postgres:5432/rag_benchmark
REDIS_URL=redis://benchmark-redis:6379/0
MINIO_ENDPOINT=benchmark-minio:9000
MINIO_ACCESS_KEY=benchmark-access-key
MINIO_SECRET_KEY=replace-with-local-benchmark-minio-secret
MINIO_BUCKET=benchmark-documents
MINIO_SECURE=false
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL_CACHE_DIR=/root/.cache/huggingface/hub
BENCHMARK_E5_CACHE_VOLUME=rag_model_cache
OLLAMA_BASE_URL=http://disabled-generation:11434
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=http://benchmark-api
RECOVERY_CONTROL_DIR=/tmp/benchmark-recovery-control
BACKUP_DESTINATION=/tmp/benchmark-backups
