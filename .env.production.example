# Copy to .env.production on the deployment host and supply values from the
# deployment secret manager. Never commit the populated file.
# This is the existing all-in-one self-hosted deployment. For future external
# services use .env.cloud-control-plane.example instead.
DEPLOYMENT_PROFILE=self_hosted
RELEASE_ID=replace-with-release-id
GIT_COMMIT_SHA=replace-with-full-git-commit-sha
DATABASE_URL=postgresql://replace-user:replace-password@postgres:5432/replace-db
DB_USER=replace-user
DB_PASSWORD=replace-password
DB_NAME=replace-db
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-access-key
MINIO_SECRET_KEY=replace-secret-key
MINIO_BUCKET=documents
MINIO_SECURE=false
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL_CACHE_DIR=/root/.cache/huggingface
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
AUTH_COOKIE_SECURE=true
SECURITY_HSTS_ENABLED=true
AUTH_TRUSTED_ORIGINS=https://rag.zkd.id.vn
TRUSTED_PROXY_CIDRS=172.16.0.0/12
GENERATION_MODEL_ID=qwen3.5:9b
GENERATION_PROMPT_VERSION=legal-rag-v2
OLLAMA_BASE_URL=http://ollama:11434
EXPECTED_MODEL_DIGEST=replace-with-verified-ollama-digest
RECOVERY_CONTROL_DIR=/recovery-control
BACKUP_DESTINATION=/backups
BACKUP_DESTINATION_ENCRYPTED=true
BACKUP_DESTINATION_SEPARATE_FAILURE_DOMAIN=true
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_LAST=7
BACKUP_SCHEDULE=manual
RQ_RESULT_TTL_SECONDS=86400
RQ_FAILURE_TTL_SECONDS=604800
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# Compose host paths; backup/control must be on the protected recovery domain.
RECOVERY_CONTROL_HOST=/replace/recovery-control
BACKUP_DESTINATION_HOST=/replace/encrypted-backups
OLLAMA_MODELS_HOST=/replace/preprovisioned-ollama
TLS_CERTIFICATE_HOST_PATH=/replace/tls.crt
TLS_PRIVATE_KEY_HOST_PATH=/replace/tls.key
