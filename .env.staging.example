# Copy to an untracked staging-host file, for example /opt/zkd-rag/.env.staging.
# This file contains placeholders only. Do not use production values, tokens, or hostnames.
DEPLOYMENT_PROFILE=cloud_control_plane
RELEASE_ID=replace-with-staging-release-id
GIT_COMMIT_SHA=replace-with-full-git-commit-sha

# Managed PostgreSQL: private SGP1 VPC hostname with TLS verification.
DATABASE_URL=postgresql://replace-user:replace-url-encoded-password@replace-private-db-host:25060/replace-staging-db?sslmode=verify-full

# Redis runs on the App Node but is reached through its VPC IP/private DNS.
REDIS_PASSWORD=replace-with-strong-url-encoded-compatible-password
REDIS_PRIVATE_BIND_ADDRESS=10.42.0.10
REDIS_URL=redis://:replace-url-encoded-password@10.42.0.10:6379/0
REDIS_DATA_HOST_PATH=/opt/zkd-rag/staging/redis-data

# DigitalOcean Spaces Standard, SGP1. Region is inferred from the endpoint.
MINIO_ENDPOINT=sgp1.digitaloceanspaces.com
MINIO_BUCKET=replace-with-globally-unique-staging-bucket
MINIO_ACCESS_KEY=replace-with-limited-staging-spaces-access-key
MINIO_SECRET_KEY=replace-with-staging-spaces-secret
MINIO_SECURE=true

# Frozen E5 artifact: populate explicitly, validate, then mount read-only.
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL_CACHE_DIR=/model-cache
EMBEDDING_MODEL_CACHE_HOST_PATH=/opt/zkd-rag/staging/e5-hub-cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Public staging edge. The actual staging tunnel token is kept only in the
# separate, untracked file named by CLOUDFLARE_TUNNEL_ENV_FILE.
# Staging tunnel token placeholder: TUNNEL_TOKEN=replace-with-staging-only-token
CLOUDFLARE_PUBLIC_ORIGIN=https://staging.zkd.id.vn
AUTH_COOKIE_SECURE=true
AUTH_TRUSTED_ORIGINS=https://staging.zkd.id.vn
SECURITY_HSTS_ENABLED=true
TRUSTED_PROXY_CIDRS=replace-with-cloudflare-proxy-cidrs
CLOUDFLARE_TUNNEL_ENV_FILE=/opt/zkd-rag/staging/.env.cloudflare.staging

# Do not provision platform-funded inference. This is the existing transitional
# external-generation runtime configuration required by the current profile.
OLLAMA_BASE_URL=https://replace-external-generation-endpoint.example.invalid
GENERATION_MODEL_ID=qwen3.5:9b
GENERATION_PROMPT_VERSION=legal-rag-v2

# Durable operational paths, separate from canonical PostgreSQL/Spaces state.
RECOVERY_CONTROL_DIR=/recovery-control
RECOVERY_CONTROL_HOST_PATH=/opt/zkd-rag/staging/recovery-control
BACKUP_DESTINATION=/backups
BACKUP_DESTINATION_HOST_PATH=/opt/zkd-rag/staging/encrypted-paired-backups
BACKUP_DESTINATION_ENCRYPTED=true
BACKUP_DESTINATION_SEPARATE_FAILURE_DOMAIN=true
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_LAST=7
BACKUP_SCHEDULE=manual

LOG_MAX_SIZE=10m
LOG_MAX_FILES=7
