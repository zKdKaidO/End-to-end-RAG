# Copy to .env.cloud-control-plane and inject real values through the runtime
# secret mechanism. This file contains placeholders only.
#
# P1 portability boundary only: this does not provision cloud services or
# enable cloud generation. P2/P3 choose and migrate the canonical services.
DEPLOYMENT_PROFILE=cloud_control_plane
RELEASE_ID=replace-with-release-id

# Externally managed canonical services. Do not use Docker-local hostnames.
DATABASE_URL=postgresql://replace-user:replace-password@postgres.example.invalid:5432/replace-db
REDIS_URL=rediss://:replace-password@redis.example.invalid:6380/0
MINIO_ENDPOINT=object-store.example.invalid:443
MINIO_ACCESS_KEY=replace-access-key
MINIO_SECRET_KEY=replace-secret-key
MINIO_BUCKET=documents
MINIO_SECURE=true

# Public edge/auth deployment configuration.
AUTH_COOKIE_SECURE=true
SECURITY_HSTS_ENABLED=true
AUTH_TRUSTED_ORIGINS=https://replace-public-origin.example.invalid
TRUSTED_PROXY_CIDRS=replace-with-proxy-cidr

# The frozen E5 model is provisioned before application start and mounted
# read-only by the portable Compose topology. No automatic model download or
# reindexing is allowed.
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL_CACHE_DIR=/model-cache
EMBEDDING_MODEL_CACHE_HOST_PATH=/replace/provisioned-e5-cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# P4 will introduce generation-provider routing. P1 only keeps the endpoint
# externalized; cloud readiness intentionally does not require Qwen yet.
OLLAMA_BASE_URL=https://replace-generation-endpoint.example.invalid
GENERATION_MODEL_ID=qwen3.5:9b
GENERATION_PROMPT_VERSION=legal-rag-v2

# Operational recovery artifacts are mounted durable paths, separate from
# canonical database/object state. P1 performs no backup migration or upload.
RECOVERY_CONTROL_DIR=/recovery-control
RECOVERY_CONTROL_HOST_PATH=/replace/durable-recovery-control
BACKUP_DESTINATION=/backups
BACKUP_DESTINATION_HOST_PATH=/replace/durable-encrypted-backups
BACKUP_DESTINATION_ENCRYPTED=true
BACKUP_DESTINATION_SEPARATE_FAILURE_DOMAIN=true
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_LAST=7
BACKUP_SCHEDULE=manual

# Required only for local Compose interpolation; never place secrets here.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7
